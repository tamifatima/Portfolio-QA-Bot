# ─────────────────────────────────────────────
#  .env  —  Environment Variables
#  NEVER commit this file to GitHub!
#  Add .env to your .gitignore
# ─────────────────────────────────────────────

# Select the generation provider: openai or groq
AI_PROVIDER=openai

# OpenAI key is used for chat and embeddings when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq key is used only for generation if AI_PROVIDER=groq
# Install langchain-groq in the backend virtual environment to use this.


# Embeddings model used for OpenAI text embeddings
EMBEDDING_MODEL=text-embedding-ada-002

# Lower temperature = more deterministic responses
AI_TEMPERATURE=0.3
 
